#!/usr/bin/env python3
"""project-studio - your projects, night runs and sessions, from the terminal (`project-studio help`).

A shim: the commands live in studio/cli.py, over the same SDK as the MCP server and the web page.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "studio"))

from cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
