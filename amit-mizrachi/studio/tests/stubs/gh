#!/usr/bin/env bash
# A stand-in for `gh` in the studio's tests. Only `gh pr list --repo <owner/repo> ...` is served.
#
# Reads under $STUDIO_STUB:
#   prs-<owner>_<repo>.json   what `gh pr list` prints for that repo. Default: [].
#   gh-fail                   if present, every call exits 1 (gh logged out or offline).
# Appends every call to $STUDIO_STUB/calls.

set -uo pipefail
S="${STUDIO_STUB:?the gh stub needs STUDIO_STUB}"
printf 'gh %s\n' "$*" >> "$S/calls"
[ -e "$S/gh-fail" ] && { echo "error connecting to api.github.com" >&2; exit 1; }
repo=""
while [ $# -gt 0 ]; do
  [ "$1" = "--repo" ] && { repo="${2:-}"; shift; }
  shift
done
cat "$S/prs-${repo//\//_}.json" 2>/dev/null || printf '[]'
